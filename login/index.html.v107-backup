<!doctype html>
<html lang="es-AR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#090a08">
  <title>Iniciar sesión — ONE MORE ELECTRONIC</title>
  <meta name="description" content="Accedé a tu cuenta ONE MORE.">
  <link rel="icon" href="../assets/favicon.ico?v=3" sizes="any">
  <link rel="apple-touch-icon" href="../assets/apple-touch-icon.png?v=3">
  <style>
    :root {
      --black:#090a08;
      --paper:#f4f2eb;
      --quiet:rgba(244,242,235,.60);
      --line:rgba(244,242,235,.28);
      --field:rgba(244,242,235,.09);
    }
    * { box-sizing:border-box; }
    html, body { width:100%; min-width:320px; min-height:100%; margin:0; }
    body { overflow:hidden; background:var(--black); color:var(--paper); font-family:Arial, Helvetica, sans-serif; }
    .account-screen { position:relative; isolation:isolate; height:100svh; min-height:520px; overflow:hidden; background:var(--black); }
    .video-area { position:absolute; z-index:-2; top:0; right:0; left:0; height:60svh; min-height:312px; overflow:hidden; background:#161813; }
    .video-area::after { position:absolute; inset:0; background:linear-gradient(to bottom,rgba(9,10,8,.04) 25%,rgba(9,10,8,.2) 52%,var(--black) 100%); content:""; }
    .video-area::before { position:absolute; z-index:1; top:0; right:0; bottom:0; left:0; opacity:.19; background-image:linear-gradient(rgba(244,242,235,.15) 1px,transparent 1px),linear-gradient(90deg,rgba(244,242,235,.15) 1px,transparent 1px); background-size:25% 25%; mask-image:linear-gradient(to bottom,black,transparent 78%); content:""; }
    video { display:block; width:100%; height:100%; object-fit:cover; object-position:center 43%; filter:grayscale(.32) brightness(.62) contrast(1.08); }
    .identity { position:absolute; z-index:2; top:clamp(22px,4vw,46px); left:clamp(22px,5.2vw,76px); display:flex; align-items:center; gap:12px; color:var(--paper); font-size:10px; font-weight:700; letter-spacing:.105em; line-height:.96; text-transform:uppercase; }
    .identity img { display:block; width:39px; height:39px; object-fit:contain; }
    .identity-name { display:block; }
    .identity { text-decoration:none; }
    .account-content { position:absolute; right:0; bottom:0; left:0; display:flex; align-items:flex-end; justify-content:center; height:60svh; min-height:350px; padding:0 clamp(22px,5.3vw,74px) clamp(25px,4.6vw,58px); }
    .account-form-wrap { width:min(100%,488px); }
    h1 { margin:0; font-size:clamp(42px,7.3vw,78px); font-weight:900; letter-spacing:-.072em; line-height:.8; text-transform:uppercase; }
    h1 span { display:block; padding-left:.072em; }
    .intro { max-width:344px; margin:17px 0 22px; color:var(--quiet); font-size:13px; line-height:1.42; }
    .credential-fields { display:grid; gap:8px; }
    .field { position:relative; }
    .field label { position:absolute; top:50%; left:15px; z-index:1; color:rgba(244,242,235,.58); font-size:11px; font-weight:700; pointer-events:none; transform:translateY(-50%); transition:top 150ms ease,font-size 150ms ease,background-color 150ms ease,color 150ms ease; }
    .field input { width:100%; height:49px; border:1px solid var(--line); border-radius:0; padding:16px 14px 4px; background:var(--field); color:var(--paper); font-size:13px; outline:none; transition:border-color 150ms ease,background-color 150ms ease,box-shadow 150ms ease; }
    .field input:focus { border-color:var(--paper); background:rgba(244,242,235,.13); box-shadow:0 0 0 3px rgba(244,242,235,.1); }
    .field input:not(:placeholder-shown) + label, .field input:focus + label { top:12px; padding:0 2px; background:var(--black); color:rgba(244,242,235,.72); font-size:8px; letter-spacing:.03em; }
    .field input::placeholder { color:transparent; }
    .field--password input { padding-right:54px; }
    .password-visibility { position:absolute; z-index:2; top:0; right:0; display:grid; width:50px; height:100%; place-items:center; margin:0; border:0; background:transparent; color:rgba(244,242,235,.68); cursor:pointer; }
    .password-visibility svg { width:18px; height:18px; fill:none; stroke:currentColor; stroke-linecap:round; stroke-linejoin:round; }
    .password-visibility .eye-slash { display:none; }
    .password-visibility.is-visible .eye-slash { display:block; }
    .password-visibility:hover, .password-visibility:focus-visible { color:var(--paper); outline:0; }
    .password-visibility:focus-visible svg { outline:2px solid var(--paper); outline-offset:4px; }
    .form-submit { display:flex; grid-column:1 / -1; align-items:center; justify-content:space-between; min-height:50px; margin-top:4px; border:1px solid var(--paper); border-radius:0; padding:0 15px 0 16px; background:var(--paper); color:var(--black); font-size:10px; font-weight:700; letter-spacing:.12em; line-height:1; text-transform:uppercase; transition:background-color 180ms ease,color 180ms ease; }
    .form-submit b { font-size:18px; font-weight:400; line-height:1; }
    .form-submit:hover, .form-submit:focus-visible { background:transparent; color:var(--paper); outline:2px solid var(--paper); outline-offset:4px; }
    .form-cancel { display:flex; align-items:center; justify-content:space-between; min-height:44px; margin-top:9px; border:1px solid rgba(244,242,235,.58); border-radius:0; padding:0 15px 0 16px; color:var(--paper); font-size:10px; font-weight:700; letter-spacing:.12em; line-height:1; text-decoration:none; text-transform:uppercase; transition:background-color 180ms ease,color 180ms ease,border-color 180ms ease; }
    .form-cancel b { font-size:17px; font-weight:400; line-height:1; }
    .form-cancel:hover, .form-cancel:focus-visible { border-color:var(--paper); background:var(--paper); color:var(--black); outline:2px solid var(--paper); outline-offset:4px; }
    .video-copy, .site-details { display:none; }

    @media (min-width:980px) {
      .account-screen { display:grid; grid-template-columns:minmax(0,1.1fr) minmax(455px,.9fr); min-height:660px; }
      .video-area { position:relative; z-index:0; grid-column:1; grid-row:1; height:100svh; min-height:660px; contain:layout paint; }
      .video-area::after { background:linear-gradient(0deg,rgba(9,10,8,.89) 0%,rgba(9,10,8,.28) 51%,rgba(9,10,8,.15) 100%); }
      .video-area::before { display:none; }
      .video-area video { filter:none; transform:translateZ(0); backface-visibility:hidden; }
      .identity { top:clamp(28px,4vw,62px); left:clamp(28px,4.7vw,74px); }
      .identity img { width:42px; height:42px; }
      .video-copy { position:absolute; z-index:2; right:clamp(30px,5.5vw,90px); bottom:clamp(38px,6.5vw,96px); left:clamp(30px,5.5vw,90px); display:block; }
      .video-copy p { margin:0 0 18px; color:rgba(244,242,235,.67); font-size:10px; font-weight:700; letter-spacing:.1em; text-transform:uppercase; }
      .video-copy h2 { max-width:none; margin:0; color:var(--paper); font-size:clamp(54px,5.15vw,88px); font-weight:900; letter-spacing:-.072em; line-height:.79; text-transform:uppercase; white-space:nowrap; }
      .video-copy h2 span { display:block; padding-left:.055em; white-space:nowrap; }
      .video-copy small { display:block; margin-top:25px; color:rgba(244,242,235,.67); font-size:11px; font-weight:700; letter-spacing:.02em; line-height:1.45; }
      .account-content { position:relative; z-index:1; grid-column:2; grid-row:1; display:flex; align-items:center; justify-content:center; height:100svh; min-height:660px; padding:clamp(38px,6.2vw,92px); border-left:1px solid rgba(244,242,235,.17); background:var(--black); }
      .account-form-wrap { width:min(100%,455px); }
      h1 { font-size:clamp(56px,4.35vw,76px); }
      .intro { max-width:405px; margin:21px 0 25px; font-size:14px; }
      .credential-fields { gap:10px; }
      .field input { height:54px; }
      .form-submit { min-height:54px; margin-top:6px; }
      .form-cancel { min-height:49px; margin-top:10px; }
      .site-details { display:grid; grid-template-columns:1fr 1fr; gap:1px; margin:clamp(28px,3.5vh,42px) 0 0; border-top:1px solid rgba(244,242,235,.24); border-bottom:1px solid rgba(244,242,235,.24); background:rgba(244,242,235,.19); }
      .site-detail { min-height:112px; padding:16px 15px; background:var(--black); }
      .site-detail span { display:block; margin:0 0 12px; color:rgba(244,242,235,.55); font-size:9px; font-weight:700; letter-spacing:.1em; line-height:1; text-transform:uppercase; }
      .site-detail strong { display:block; color:var(--paper); font-size:18px; font-weight:900; letter-spacing:-.07em; line-height:.8; text-transform:uppercase; }
      .site-detail p { margin:9px 0 0; color:rgba(244,242,235,.7); font-size:10px; font-weight:700; letter-spacing:.015em; line-height:1.38; }
      .site-detail--venue strong { font-size:14px; letter-spacing:-.04em; }
    }
    @media (max-height:650px) and (max-width:979px) {
      .account-screen { min-height:0; }
      .video-area { min-height:0; }
      .account-content { padding-bottom:18px; }
      .intro { margin:12px 0 15px; }
      .field input { height:45px; }
      .form-submit { min-height:45px; }
      .form-cancel { min-height:42px; margin-top:7px; }
    }
    @media (prefers-reduced-motion:reduce) { *,*::before,*::after { animation-duration:.01ms!important; animation-iteration-count:1!important; transition-duration:.01ms!important; } }
  </style>
</head>
<body>
  <main class="account-screen" aria-labelledby="account-title">
    <div class="video-area">
      <video aria-hidden="true" autoplay muted loop playsinline preload="auto">
        <source src="../assets/one-more-hero.mp4" type="video/mp4">
      </video>
      <div class="video-copy">
        <p>ONE MORE CLUB · DEVOTO</p>
        <h2>La noche<span>no termina.</span></h2>
        <small>Electrónica, comunidad y una noche que no termina.</small>
      </div>
    </div>

    <a class="identity" href="/" aria-label="Volver al inicio de ONE MORE ELECTRONIC"><img src="../assets/one-logo.webp" alt=""><span class="identity-name">ONE MORE<br>ELECTRONIC</span></a>

    <section class="account-content">
      <div class="account-form-wrap">
        <h1 id="account-title">Tu cuenta<span>ONE MORE.</span></h1>
        <p class="intro">Un espacio pensado para reunir tus próximas reservas, accesos y experiencias de ONE MORE. Ingresá tu correo y contraseña para continuar.</p>
        <form id="visual-login-form" class="credential-fields" aria-label="Datos de acceso">
          <div class="field">
            <input id="account-email" name="email" type="email" inputmode="email" autocomplete="email" placeholder="Correo electrónico" aria-label="Correo electrónico" required>
            <label for="account-email">Correo electrónico</label>
          </div>
          <div class="field field--password">
            <input id="account-password" name="password" type="password" autocomplete="current-password" placeholder="Contraseña" aria-label="Contraseña" minlength="1" required>
            <label for="account-password">Contraseña</label>
            <button class="password-visibility" data-password-visibility type="button" aria-label="Mostrar contraseña" aria-controls="account-password" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M2.5 12s3.4-5.5 9.5-5.5S21.5 12 21.5 12 18.1 17.5 12 17.5 2.5 12 2.5 12Z"/><circle cx="12" cy="12" r="2.7"/><path class="eye-slash" d="m4 4 16 16"/></svg></button>
          </div>
          <button class="form-submit" type="submit"><span>Ingresar</span><b aria-hidden="true">↗</b></button>
        </form>
        <a class="form-cancel" href="/" aria-label="Cancelar el ingreso y volver al inicio"><span>Cancelar</span><b aria-hidden="true">←</b></a>
        <section class="site-details" aria-label="Información de ONE MORE CLUB">
          <div class="site-detail">
            <span>Próxima fecha</span>
            <strong>Festa Bros</strong>
            <p>Sábado 31 OCT · 23:59 Hs</p>
          </div>
          <div class="site-detail site-detail--venue">
            <span>ONE MORE CLUB</span>
            <strong>Villa Devoto</strong>
            <p>Av. Francisco Beiró 3334<br>Buenos Aires</p>
          </div>
        </section>
      </div>
    </section>
  </main>

  <script>
    (() => {
      const VISUAL_ACCESS_KEY = 'one-more-visual-access';
      const form = document.getElementById('visual-login-form');
      const password = document.getElementById('account-password');
      const passwordVisibility = document.querySelector('[data-password-visibility]');
      passwordVisibility.addEventListener('click', () => {
        const revealing = password.type === 'password';
        password.type = revealing ? 'text' : 'password';
        passwordVisibility.classList.toggle('is-visible', revealing);
        passwordVisibility.setAttribute('aria-pressed', String(revealing));
        passwordVisibility.setAttribute('aria-label', revealing ? 'Ocultar contraseña' : 'Mostrar contraseña');
      });
      form.addEventListener('submit', (event) => {
        event.preventDefault();
        if (!form.checkValidity()) {
          form.reportValidity();
          return;
        }
        // This prototype deliberately stores only a harmless visual state marker.
        // Email and password values are never read, transmitted, or persisted.
        try { window.localStorage.setItem(VISUAL_ACCESS_KEY, 'active'); } catch (_) {}
        window.location.assign('/');
      });
    })();
  </script>
</body>
</html>
